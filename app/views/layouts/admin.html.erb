<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Админка | Поисковик рецептов" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body">
    <header class="site-header admin-header">
      <nav class="site-nav">
        <%= link_to "Админка рецептов", admin_root_path, class: "brand" %>
        <div class="nav-actions">
          <%= link_to "На сайт", root_path %>
          <%= link_to "Рецепты", admin_recipes_path if current_admin_user %>
          <%= link_to "Категории", admin_categories_path if current_admin_user %>
          <%= link_to "Ингредиенты", admin_ingredients_path if current_admin_user %>
          <%= button_to "Выйти", admin_logout_path, method: :delete, class: "link-button" if current_admin_user %>
        </div>
      </nav>
    </header>

    <% flash.each do |type, message| %>
      <div class="flash flash-<%= type %>"><%= message %></div>
    <% end %>

    <main class="admin-main">
      <%= yield %>
    </main>
  </body>
</html>