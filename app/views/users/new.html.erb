<% content_for :title, "Регистрация" %>

<section class="admin-panel auth-panel">
  <h1>Регистрация</h1>
  <%= render "shared/errors", record: @user %>

  <%= form_with model: @user, url: users_path, class: "admin-form" do |form| %>
    <label>
      <span>Имя</span>
      <%= form.text_field :full_name, required: true, autocomplete: "name" %>
    </label>

    <label>
      <span>Почта</span>
      <%= form.email_field :email, required: true, autocomplete: "email" %>
    </label>

    <label>
      <span>О себе</span>
      <%= form.text_area :bio, rows: 4, placeholder: "Например: люблю домашнюю выпечку и быстрые ужины." %>
    </label>

    <label>
      <span>Пароль</span>
      <%= form.password_field :password, required: true, autocomplete: "new-password" %>
    </label>

    <label>
      <span>Повтор пароля</span>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
    </label>

    <%= form.submit "Создать аккаунт", class: "primary-button" %>
  <% end %>
</section>