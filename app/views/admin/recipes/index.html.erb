<section class="admin-panel">
  <div class="admin-title-row">
    <h1>Рецепты</h1>
    <%= link_to "Новый рецепт", new_admin_recipe_path, class: "primary-button" %>
  </div>

  <table class="admin-table">
    <thead>
      <tr>
        <th>Название</th>
        <th>Автор</th>
        <th>Категория</th>
        <th>Время</th>
        <th>Статус</th>
        <th>Действия</th>
      </tr>
    </thead>
    <tbody>
      <% @recipes.each do |recipe| %>
        <tr>
          <td><%= recipe.title %></td>
          <td><%= recipe.user&.full_name || "Редакция" %></td>
          <td><%= recipe.category.name %></td>
          <td><%= recipe.cooking_time %> мин</td>
          <td><%= recipe.published? ? "Опубликован" : "Черновик" %></td>
          <td class="table-actions">
            <%= link_to "Редактировать", edit_admin_recipe_path(recipe) %>
            <% if recipe.published? %>
              <%= button_to "Снять", unpublish_admin_recipe_path(recipe), method: :patch, class: "link-button" %>
            <% else %>
              <%= button_to "Опубликовать", publish_admin_recipe_path(recipe), method: :patch, class: "link-button" %>
            <% end %>
            <%= button_to "Удалить", admin_recipe_path(recipe), method: :delete, class: "danger-button" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>