<% content_for :title, "Вход" %>

<section class="admin-panel auth-panel">
  <h1>Вход в личный кабинет</h1>

  <%= form_with url: login_path, class: "admin-form" do |form| %>
    <label>
      <span>Почта</span>
      <%= form.email_field :email, required: true, autocomplete: "email" %>
    </label>

    <label>
      <span>Пароль</span>
      <%= form.password_field :password, required: true, autocomplete: "current-password" %>
    </label>

    <%= form.submit "Войти", class: "primary-button" %>
  <% end %>

  <p class="muted-text">Нет аккаунта? <%= link_to "Зарегистрироваться", signup_path %></p>
</section>