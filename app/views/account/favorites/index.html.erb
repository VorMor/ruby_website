<% content_for :title, "Избранные рецепты" %>

<section class="admin-panel">
  <div class="admin-title-row">
    <div>
      <p class="eyebrow">Личный кабинет</p>
      <h1>Избранные рецепты</h1>
    </div>
    <%= link_to "Найти новые рецепты", recipes_path, class: "primary-button" %>
  </div>

  <% if @recipes.any? %>
    <div class="recipe-grid">
      <%= render partial: "recipes/card", collection: @recipes, as: :recipe %>
    </div>
  <% else %>
    <p class="muted-text">Вы пока не добавили рецепты в избранное.</p>
  <% end %>
</section>