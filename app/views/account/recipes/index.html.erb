<% content_for :title, "Мои рецепты" %>

<section class="admin-panel">
  <div class="admin-title-row">
    <div>
      <p class="eyebrow">Личный кабинет</p>
      <h1>Мои рецепты</h1>
    </div>
    <%= link_to "Добавить рецепт", new_account_recipe_path, class: "primary-button" %>
  </div>

  <% if @recipes.any? %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Название</th>
          <th>Категория</th>
          <th>Время</th>
          <th>Статус</th>
          <th>Действия</th>
        </tr>
      </thead>
      <tbody>
        <% @recipes.each do |recipe| %>
          <tr>
            <td><%= link_to recipe.title, recipe_path(recipe) if recipe.published? %><%= recipe.title unless recipe.published? %></td>
            <td><%= recipe.category.name %></td>
            <td><%= recipe.cooking_time %> мин</td>
            <td><%= recipe.published? ? "Опубликован" : "Черновик" %></td>
            <td class="table-actions">
              <%= link_to "Редактировать", edit_account_recipe_path(recipe) %>
              <%= button_to "Удалить", account_recipe_path(recipe), method: :delete, class: "danger-button" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="muted-text">Вы еще не добавили ни одного рецепта.</p>
  <% end %>
</section>